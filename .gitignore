# Environment
.env
# Catch all dotenv variants (.env.local, .env.production, etc); the negation
# below must stay directly after so a tracked template can't get swept up.
.env.*
!.env.example

# Logs
*.log

# Docker
docker-compose.override.yml

# Notes and scratch
notes/

# Claude code
creds.json
.claude/skills/owasp-scan/findings.json
.github/drafts/

# Build-orchestration harness (agent-worktree.sh / agent-scope-jail.sh); all throwaway
.agent-worktrees/
.agent-scope/

# Subagent prompt captures + deferred analysis; README and template stay tracked
build-orchestration/prompt-log/*
!build-orchestration/prompt-log/README.md
!build-orchestration/prompt-log/_template.md

# Escalation strike count + SubagentStop route-guard loop-guard — live scratch
build-orchestration/strike-count.md
build-orchestration/route-block-count

# Session baton — session-start/session-end handoff; local per-session state.
# The template stays tracked to hold the shape.
docs/session/baton.md

# User-supplied audio tracks; example manifest stays tracked to hold the shape.
client/assets/tracks/*
!client/assets/tracks/manifest.example.json

# Audio files anywhere in the repo (never commit, per project rule)
*.wav
*.mp3
*.flac
*.aiff
*.ogg
